include LICENSE
include README.md DROITS.md CITATION.cff pyproject.toml THIRD_PARTY_NOTICES.txt
recursive-include tools *.py
recursive-include requirements *.txt
recursive-include interface/frontend *.json *.js *.jsx *.css *.html *.mjs
recursive-include interface/tests *.py
recursive-include implementation_v2/tests *.py
include implementation_v2/config.py
recursive-include implementation_v2/data *.py
include implementation_v2/README.md
prune interface/frontend/node_modules
prune interface/frontend/dist
prune interface/.runtime
prune study
prune qa
prune releases
global-exclude *.pyc *.sqlite* .DS_Store

exclude docs/prd-interface_codex_v1_2026-09-08.md

recursive-include examples *.py


include setup.py SOURCE_MANIFEST.json
recursive-include docs *.md
recursive-include examples *.ipynb *.md
recursive-include implementation_v2/helm/ui/static *.html *.js *.css *.txt
recursive-include .github/workflows *.yml
